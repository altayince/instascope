{
  "name": "instascope-product-events",
  "main": "analytics.ts",
  "compatibility_date": "2026-09-26",
  "workers_dev": false,
  "analytics_engine_datasets": [
    { "binding": "EVENTS", "dataset": "instascope_events" },
  ],
  "ratelimits": [
    {
      "name": "RATE_LIMITER",
      "namespace_id": "1002",
      "simple": { "limit": 60, "period": 60 },
    },
  ],
  "observability": { "enabled": false },
}
