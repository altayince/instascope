# Set the real production origin before deployment. Unconfigured builds are noindex.
NEXT_PUBLIC_SITE_URL=https://instascope.me
# Set true for preview builds, even if an inherited production origin is present.
NEXT_PUBLIC_PREVIEW=
# Optional same-origin endpoint path. No events leave the browser unless configured.
NEXT_PUBLIC_ANALYTICS_ENDPOINT=
# Optional same-origin public-photo Worker route, e.g. /api/profile-picture
NEXT_PUBLIC_PROFILE_ENDPOINT=
